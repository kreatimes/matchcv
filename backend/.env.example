# Clave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_de_google_ai_studio

# InfoJobs (https://developer.infojobs.net). Sin claves, esta fuente no se activa.
# INFOJOBS_CLIENT_ID=
# INFOJOBS_CLIENT_SECRET=

# Fuente de prueba con ofertas inventadas (true por defecto). Ponla a false con fuentes reales.
# MATCHCV_FAKE_SOURCE=false

# Opcionales
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
